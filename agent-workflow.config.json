{
  "kitVersion": "0.2.0",
  "project": {
    "name": "gitterm-v6",
    "facts": ["Protected branches: `v4`, `v5`, `v6`."]
  },
  "commands": {
    "build": "cargo build",
    "test": "cargo test",
    "lint": "cargo clippy -- -D warnings",
    "format": "cargo fmt -- --check"
  },
  "git": {
    "baseBranch": "v6",
    "issueKeyPattern": "TRU-[0-9]+"
  },
  "checkpointFile": ".agents/checkpoint.md",
  "overlaysDir": ".agent-workflow/overlays",
  "harnesses": { "claude": true }
}
