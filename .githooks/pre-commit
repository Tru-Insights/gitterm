#!/bin/sh
# Pre-commit hook — runs Clippy, the format check and the tests to catch CI
# failures before they ship.
#
# Checked into the repo so every dev runs the same gate. To activate after
# cloning (or after pulling this change for the first time):
#
#     git config core.hooksPath .githooks
#
# BUILD.md records this as the setup step.

set -e

echo "Running cargo clippy (lint)..."
if ! scripts/cargo.sh clippy --quiet -- -D warnings; then
    echo ""
    echo "ERROR: Clippy failed. Fix the errors above before committing."
    echo "Reproduce with: cargo clippy -- -D warnings"
    exit 1
fi
echo "Lint passed."
echo ""

echo "Running cargo fmt --check..."
if ! scripts/cargo.sh fmt --all -- --check; then
    echo ""
    echo "ERROR: Formatting drift. Run 'cargo fmt' and re-stage."
    exit 1
fi
echo "Format passed."
echo ""

echo "Running cargo test..."
if ! scripts/cargo.sh test --quiet; then
    echo ""
    echo "ERROR: Tests failed. Fix the failures above before committing."
    echo "Reproduce with: cargo test"
    exit 1
fi
echo "Tests passed."
echo ""

if [ "$(uname -s)" = Darwin ]; then
    echo "Checking the separate GPUI workspace..."
    scripts/check-gpui-deps.sh
    scripts/cargo.sh fmt --manifest-path gpui/Cargo.toml -- --check
fi

echo "All pre-commit gates passed."
